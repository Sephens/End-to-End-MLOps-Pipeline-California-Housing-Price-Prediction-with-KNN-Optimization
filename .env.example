# Copy this to .env for local development (never commit .env to git)

# FastAPI
MODEL_PATH=california_knn_pipeline.pkl

# Streamlit — point at your local API or deployed Render URL
API_URL=http://localhost:8000

# MLflow — local sqlite backend
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Prefect — local server
PREFECT_API_URL=http://localhost:4200/api
